# These values are for the isolated, fictional local starter only.
POSTGRES_USER=room_booking
POSTGRES_PASSWORD=room_booking_local
POSTGRES_DB=room_booking

# Optional host ports; service-to-service ports remain unchanged.
WEB_PORT=13000
KONG_PORT=18080
POSTGRES_PORT=15432

# Compose otherwise uses the directory name. On a shared Docker daemon,
# give copies with the same directory name different project identities.
# COMPOSE_PROJECT_NAME=common-room-your-name
